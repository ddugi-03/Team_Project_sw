# Export these variables before starting the server, or start from backend with
# python -m uvicorn main:app --reload --env-file .env.example
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Comma-separated origins. An empty value disables cross-origin access.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
